# Where the hosted copy of the demo site lives, and how `make publish` builds and pushes it (docs/hosting.md).
# Shell syntax: the publish script sources it, and nothing else reads it.
#
# SITE_BASE_PATH is the prefix every link in the built pages is written with. A GitHub Pages project site
# is https://<user>.github.io/<repo>/, so the site's own /app/direct-file sits under /<repo>. A host that
# serves at the root of its own domain (Cloudflare Pages, Netlify, a user site) takes /app/direct-file.
# The output folder is out/app/direct-file either way; the host adds its prefix in front of it.
SITE_REMOTE=origin
SITE_BRANCH=gh-pages
SITE_BASE_PATH=/direct-file-virginia/app/direct-file
SITE_URL=https://gchickering21.github.io/direct-file-virginia/app/direct-file/resources/start/
