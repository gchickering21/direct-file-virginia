    <Fact path="/vaOwesVirginia">
      <Name>The return ends with an amount owed</Name>
      <Description>Line 35 is positive. Gates the owe row on the summary and the running estimate.</Description>
      <Derived>
        <GreaterThan>
          <Left><Dependency module="virginiaResult" path="/vaAmountYouOwe" /></Left>
          <Right><Dollar>0</Dollar></Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <Fact path="/vaIsOwedRefund">
      <Name>The return ends with a refund</Name>
      <Description>Line 36 is positive. Gates the refund row on the summary and the running estimate.</Description>
      <Derived>
        <GreaterThan>
          <Left><Dependency module="virginiaResult" path="/vaRefund" /></Left>
          <Right><Dollar>0</Dollar></Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <Fact path="/vaOwesNothing">
      <Name>The return ends even: nothing owed, no refund</Name>
      <Derived>
        <All>
          <Not><Dependency path="/vaOwesVirginia" /></Not>
          <Not><Dependency path="/vaIsOwedRefund" /></Not>
        </All>
      </Derived>
    </Fact>

    <Fact path="/vaMilitaryBasicPayExceedsMaximum">
      <Name>The basic pay entered is at or above the amount where the subtraction ends</Name>
      <Description>For the note under the basic pay question: at $30,000 or more nothing is
        subtracted (Va. Code § 58.1-322.02(15)).</Description>
      <Derived>
        <GreaterThanOrEqual>
          <Left><Dependency module="virginiaIncome" path="/vaMilitaryBasicPay" /></Left>
          <Right><Dependency module="virginiaConstants" path="/vaMilitaryBasicPayMaximum" /></Right>
        </GreaterThanOrEqual>
      </Derived>
    </Fact>

    <Fact path="/vaMilitaryRetirementExceedsMaximum">
      <Name>The military benefits entered exceed the $30,000 the subtraction covers</Name>
      <Derived>
        <GreaterThan>
          <Left><Dependency module="virginiaIncome" path="/vaMilitaryRetirementIncome" /></Left>
          <Right><Dependency module="virginiaConstants" path="/vaMilitaryBenefitsMaximum" /></Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <Fact path="/vaCommonwealthSaversExceedsCap">
      <Name>The Commonwealth Savers contribution entered exceeds the cap, and the cap applies</Name>
      <Description>For the note under the contribution question: above $4,000 only the cap is
        deducted unless the filer has attained age 70 (Va. Code § 58.1-322.03(7)).</Description>
      <Derived>
        <All>
          <Not><Dependency module="virginiaDeductions" path="/vaPrimaryFilerAge70OrOlder" /></Not>
          <GreaterThan>
            <Left><Dependency module="virginiaDeductions" path="/vaCommonwealthSaversContributions" /></Left>
            <Right><Dependency module="virginiaConstants" path="/vaCommonwealthSaversCap" /></Right>
          </GreaterThan>
        </All>
      </Derived>
    </Fact>

