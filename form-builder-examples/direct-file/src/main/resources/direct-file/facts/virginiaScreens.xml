<?xml-model href="./FactDictionaryModule.rng"?>
<!--
  Virginia resident return, tax year 2024: prototype rules, not a return. One of the Virginia
  modules (facts/virginia*.xml), loaded as one dictionary beside the federal modules; the
  Virginia README in docs/virginia/ lists them and docs/adr/003-the-layout-for-growth.md says
  why they are split. Every fact names its source: Va. Code Title 58.1, Chapter 3
  (https://law.lis.virginia.gov/vacode/title58.1/) and the 2024 Form 760 instructions. A module
  reads federal facts only through what the federal return exports to states
  (stateSystems="true") or to MeF (mef="true"); scripts/check-virginia-exports.py enforces it.

  This module: facts the screens need and the return does not: the correction round's gates, the
  declaration and the Send button's fact, the records match, the locality names for the notes, who
  owes what, and the over-the-cap notes on the question screens.
-->
<FactDictionaryModule>
  <Facts>


    <!-- ============ The correction round: gates for the correction screens. ============ -->

    <Fact path="/vaEverythingRight">
      <Name>Everything on the what-is-known screen is right</Name>
      <Description>Asked after the facts are shown. No sends the filer to the correction screens.
        Flow control only; not a return value.</Description>
      <Writable><Boolean /></Writable>
    </Fact>

    <Fact path="/vaWantsToCorrect">
      <Name>The filer wants to correct something</Name>
      <Derived><Not><Dependency path="/vaEverythingRight" /></Not></Derived>
    </Fact>

    <Fact path="/vaCorrectionTargetOptions">
      <Name>What can be corrected here</Name>
      <Description>The three things the prototype lets a filer correct on the Virginia side: the date
        of birth (a fact the filer stated), a W-2 (a document, corrected as a whole) and a payment
        Virginia's records show (Lines 20 to 22, the records stand-in). Calculated amounts are never
        editable.</Description>
      <Derived>
        <EnumOptions>
          <String>dateOfBirth</String>
          <String>w2</String>
          <String>records</String>
        </EnumOptions>
      </Derived>
    </Fact>

    <Fact path="/vaCorrectionTarget">
      <Name>What the filer chose to correct</Name>
      <Writable><Enum optionsPath="/vaCorrectionTargetOptions" /></Writable>
    </Fact>

    <Fact path="/vaCorrectionTargetIsDateOfBirth">
      <Name>Correcting the date of birth</Name>
      <Derived>
        <All>
          <Dependency path="/vaWantsToCorrect" />
          <Equal>
            <Left><Dependency path="/vaCorrectionTarget" /></Left>
            <Right><Enum optionsPath="/vaCorrectionTargetOptions">dateOfBirth</Enum></Right>
          </Equal>
        </All>
      </Derived>
    </Fact>

    <Fact path="/vaCorrectionTargetIsW2">
      <Name>Correcting a W-2</Name>
      <Derived>
        <All>
          <Dependency path="/vaWantsToCorrect" />
          <Equal>
            <Left><Dependency path="/vaCorrectionTarget" /></Left>
            <Right><Enum optionsPath="/vaCorrectionTargetOptions">w2</Enum></Right>
          </Equal>
        </All>
      </Derived>
    </Fact>

    <Fact path="/vaCorrectionTargetIsRecords">
      <Name>Correcting a payment Virginia's records show</Name>
      <Description>Lines 20 to 22 are filled from the records stand-in (js/virginia-records.js) once
        per identity and never overwritten after that, so a correction made here persists.</Description>
      <Derived>
        <All>
          <Dependency path="/vaWantsToCorrect" />
          <Equal>
            <Left><Dependency path="/vaCorrectionTarget" /></Left>
            <Right><Enum optionsPath="/vaCorrectionTargetOptions">records</Enum></Right>
          </Equal>
        </All>
      </Derived>
    </Fact>

    <!-- ============ Screen facts: the declaration and the records match. ============ -->
    <!-- Facts the screens need and the return does not: what the filer signed, what the records
         stand-in found, which of two rows to show, the pieces of a line for its "why this number"
         disclosure. None of them changes a Form 760 figure. -->

    <Fact path="/vaDeclarationOptions">
      <Name>The one box on the sign screen</Name>
      <Derived>
        <EnumOptions>
          <String>signed</String>
        </EnumOptions>
      </Derived>
    </Fact>

    <Fact path="/vaDeclaration">
      <Name>The declaration box on the sign screen, checked</Name>
      <Description>A single USWDS checkbox (a multi-enum with one option, the only checkbox the
        runtime renders) carrying the Form 760 declaration as its label. Required: the sign screen
        cannot be left until it is checked, and js/virginia-sign.js refuses to send without it.</Description>
      <Writable>
        <MultiEnum optionsPath="/vaDeclarationOptions" />
      </Writable>
    </Fact>

    <Fact path="/vaDeclarationSigned">
      <Name>The filer signed the declaration and pressed Send to Virginia Tax</Name>
      <Description>Set to true by the Send button on the sign screen (js/virginia-sign.js) once the
        declaration box is checked, and back to false when the box is cleared. False until then.
        Demonstration only: nothing is transmitted; the screen says so when this is true.</Description>
      <Writable><Boolean /></Writable>
      <Placeholder><False /></Placeholder>
    </Fact>

    <Fact path="/vaRecordsKey">
      <Name>The identity the records stand-in was last applied for</Name>
      <Description>Last name and date of birth, joined with a bar, as js/virginia-records.js keys the
        stand-in. The stand-in writes Lines 20 to 22 only when this differs from the identity on the
        return, so a correction the filer makes to those lines is never overwritten.</Description>
      <Writable><String /></Writable>
    </Fact>

    <Fact path="/vaRecordsMatched">
      <Name>Virginia's records hold a match for this filer</Name>
      <Description>Set by js/virginia-records.js: true when the stand-in has a record under the
        filer's last name and date of birth, false when it has none (and Lines 20 to 22 are $0).
        Incomplete until the stand-in has been consulted.</Description>
      <Writable><Boolean /></Writable>
    </Fact>

    <Fact path="/vaLocalityFromAddressName">
      <Name>The name of the locality the filer's ZIP code lies in</Name>
      <Description>Written beside /vaLocalityFromAddress by js/virginia-locality.js, from the ZIP
        table's names. A proper noun, the same in every language.</Description>
      <Writable><String /></Writable>
    </Fact>

